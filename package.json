{
  "name": "screenloom-monorepo",
  "private": true,
  "description": "ScreenLoom: React forms aur CRUD screens JSON se",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "storybook": "pnpm --filter @screenloom/docs storybook",
    "build-storybook": "pnpm --filter @screenloom/docs build-storybook",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=./packages/* && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
